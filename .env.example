# Application data stays in the project's data directory, excluded from Git.
ASTER_HOME=./data
ASTER_MODEL_URL=http://127.0.0.1:8000/v1
ASTER_MODEL=auto
ASTER_RETRIEVAL_MODE=auto
ASTER_EMBEDDING_MODEL=BAAI/bge-m3
ASTER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ASTER_RETRIEVAL_DEVICE=cpu
ASTER_MODEL_THREADS=4
# Optional GPU retrieval worker:
# ASTER_RETRIEVAL_URL=http://127.0.0.1:8767
# Optional PostgreSQL; file assets still live under ASTER_HOME:
# ASTER_DATABASE_URL=postgresql+psycopg://aster:password@127.0.0.1:5433/aster
# Docker uses ASTER_CONTAINER_DATABASE_URL, so a host SQLite path is never passed into the container.
# Required for non-loopback access:
# ASTER_ACCESS_TOKEN=choose-a-long-random-access-token
# Shared harness experiment: adaptive (default) or baseline.
MINI_HARNESS_CONTEXT_POLICY=adaptive
