# Export the required values before starting Aster.
ASTER_MODEL_URL=http://127.0.0.1:8000/v1
ASTER_MODEL=auto
# ASTER_DATA_DIR=.local/aster
# Existing installations retain .local/zhixu automatically.
# auto uses hybrid only when both retrieval models are installed; otherwise UI reports BM25 fallback.
ASTER_RETRIEVAL_MODE=auto
ASTER_EMBEDDING_MODEL=BAAI/bge-m3
ASTER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ASTER_RETRIEVAL_DEVICE=cpu
ASTER_MODEL_THREADS=4
# Optional PostgreSQL (install/migrate using the same application):
# ASTER_DATABASE_URL=postgresql+psycopg://zhixu:password@127.0.0.1:5433/zhixu
# Required when binding a non-loopback address:
# ASTER_ACCESS_TOKEN=choose-a-long-random-access-token

# Optional loopback GPU worker (started separately):
# ASTER_RETRIEVAL_URL=http://127.0.0.1:8767
# Legacy ZHIXU_ variables remain supported; ASTER_ takes precedence.
